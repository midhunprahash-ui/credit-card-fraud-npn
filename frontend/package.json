{
  "name": "npn-fraud-analyst-frontend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b --pretty false",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "deploy": "npm run build && wrangler pages deploy dist --branch main"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
